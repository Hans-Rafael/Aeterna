# Copiar a `.env` y completar. Nunca subir `.env` a git.

# Supabase (público)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (SECRETO, solo servidor: el panel de admin lo necesita)
SUPABASE_SERVICE_ROLE_KEY=

# Admin del sitio
# Generar el hash con: node scripts/hash-password.mjs "tu-contraseña"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Generar con: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Mercado Pago (usar el Access Token de PRUEBA hasta pasar a producción)
MP_ACCESS_TOKEN=
